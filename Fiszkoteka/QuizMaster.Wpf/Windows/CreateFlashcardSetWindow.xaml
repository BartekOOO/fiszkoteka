<Window x:Class="QuizMaster.Wpf.Windows.CreateFlashcardSetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nowy zestaw fiszek"
        Height="430"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">

    <Border Padding="26"
            Background="#F8FAFC">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,22">

                <TextBlock Text="Utwórz zestaw"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>

                <TextBlock Text="Podaj podstawowe informacje o zestawie fiszek."
                           FontSize="14"
                           Foreground="#64748B"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Formularz -->
            <StackPanel Grid.Row="1">

                <!-- Nazwa -->
                <TextBlock Text="Nazwa zestawu"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,0,0,6"/>

                <Border Background="White"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="42"
                        Padding="10,0"
                        Margin="0,0,0,16">

                    <TextBox x:Name="NameTextBox"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"
                             FontSize="14"/>
                </Border>

                <!-- Kategoria -->
                <TextBlock Text="Kategoria"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,0,0,6"/>

                <Border Background="White"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="42"
                        Padding="8,0"
                        Margin="0,0,0,16">

                    <ComboBox x:Name="CategoryComboBox"
                              BorderThickness="0"
                              Background="Transparent"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              VerticalContentAlignment="Center"
                              FontSize="14"/>
                </Border>

                <!-- Opis -->
                <TextBlock Text="Opis"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,0,0,6"/>

                <Border Background="White"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="95"
                        Padding="10">

                    <TextBox x:Name="DescriptionTextBox"
                             BorderThickness="0"
                             Background="Transparent"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             FontSize="14"/>
                </Border>
            </StackPanel>

            <!-- Przyciski -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,22,0,0">

                <Button Content="Anuluj"
                        Width="100"
                        Height="38"
                        Background="#E2E8F0"
                        Foreground="#334155"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>

                <Button Content="Utwórz"
                        Width="110"
                        Height="38"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="CreateButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>