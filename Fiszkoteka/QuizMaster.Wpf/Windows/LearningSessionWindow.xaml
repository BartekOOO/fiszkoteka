<Window x:Class="QuizMaster.Wpf.Windows.LearningSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sesja nauki"
        Width="520"
        Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">

    <Window.Resources>

        <Style x:Key="LearningButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HintLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       TextDecorations="Underline"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Padding="28">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,22">

                <TextBlock Text="Sesja nauki"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>

                <TextBlock x:Name="FlashcardSetNameTextBlock"
                           Text="Zestaw fiszek"
                           FontSize="15"
                           Foreground="#64748B"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Karta -->
            <Grid Grid.Row="1">

                <Border x:Name="CardBorder"
                        Background="White"
                        CornerRadius="22"
                        Padding="28"
                        Cursor="Hand"
                        MouseLeftButtonUp="CardBorder_MouseLeftButtonUp"
                        RenderTransformOrigin="0.5,0.5">

                    <Border.RenderTransform>
                        <ScaleTransform x:Name="CardScaleTransform"
                                        ScaleX="1"
                                        ScaleY="1"/>
                    </Border.RenderTransform>

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28"
                                          ShadowDepth="0"
                                          Opacity="0.13"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="CardSideTextBlock"
                                   Grid.Row="0"
                                   Text="Pytanie"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#2563EB"/>

                        <TextBlock x:Name="CardTextBlock"
                                   Grid.Row="1"
                                   Text="Kliknij, aby rozpocząć"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>

                        <TextBlock x:Name="CardFooterTextBlock"
                                   Grid.Row="2"
                                   Text="Kliknij kartę, aby zobaczyć odpowiedź."
                                   FontSize="13"
                                   Foreground="#94A3B8"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="0,18,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Podpowiedź poza kartą -->
            <StackPanel Grid.Row="2"
                        Margin="0,16,0,0">

                <Button x:Name="ShowHintButton"
                        Content="Podpowiedź"
                        Style="{StaticResource HintLinkButtonStyle}"
                        Click="ShowHintButton_Click"/>

                <Border x:Name="HintPanel"
                        Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,10,0,0"
                        Visibility="Collapsed">

                    <TextBlock x:Name="HintTextBlock"
                               Text=""
                               FontSize="14"
                               Foreground="#1E40AF"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- Dobrze / źle -->
            <Grid Grid.Row="3"
                  Margin="0,24,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="WrongButton"
                        Grid.Column="0"
                        Content="✕  Źle"
                        Background="#FEE2E2"
                        Foreground="#DC2626"
                        Style="{StaticResource LearningButtonStyle}"
                        Click="WrongButton_Click"/>

                <Button x:Name="CorrectButton"
                        Grid.Column="2"
                        Content="✓  Dobrze"
                        Background="#DCFCE7"
                        Foreground="#15803D"
                        Style="{StaticResource LearningButtonStyle}"
                        Click="CorrectButton_Click"/>
            </Grid>

            <!-- Progress -->
            <StackPanel Grid.Row="4"
                        Margin="0,24,0,0">

                <ProgressBar x:Name="SessionProgressBar"
                             Height="10"
                             Minimum="0"
                             Maximum="1"
                             Value="0"
                             Foreground="#2563EB"
                             Background="#E2E8F0"/>

                <TextBlock x:Name="ProgressTextBlock"
                           Text="0 / 0 fiszek"
                           FontSize="13"
                           Foreground="#64748B"
                           HorizontalAlignment="Right"
                           Margin="0,8,0,0"/>

                <Button x:Name="FinishButton"
                        Content="Zakończ"
                        Height="44"
                        Margin="0,18,0,0"
                        Background="#2563EB"
                        Foreground="White"
                        Style="{StaticResource LearningButtonStyle}"
                        Visibility="Collapsed"
                        Click="FinishButton_Click"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>