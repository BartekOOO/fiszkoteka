<Window x:Class="QuizMaster.Wpf.Windows.EditFlashcardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fiszka"
        Width="420"
        Height="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,18">
                <TextBlock Text="Fiszka"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>

                <TextBlock Text="Podaj pytanie, odpowiedź i opcjonalną podpowiedź."
                           FontSize="14"
                           Foreground="#64748B"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1">

                <TextBlock Text="Pytanie"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="QuestionTextBox"
                         Height="70"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Padding="10"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Odpowiedź"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="AnswerTextBox"
                         Height="70"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Padding="10"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Podpowiedź"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="HintTextBox"
                         Height="42"
                         Padding="10,0"
                         VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">

                <Button Content="Anuluj"
                        Width="100"
                        Height="38"
                        Background="#E2E8F0"
                        Foreground="#334155"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>

                <Button Content="Zapisz"
                        Width="110"
                        Height="38"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>