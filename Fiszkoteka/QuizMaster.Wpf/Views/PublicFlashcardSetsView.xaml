<UserControl x:Class="QuizMaster.Wpf.Views.PublicFlashcardSetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="850">

    <Grid Background="#F8FAFC">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0"
                   Margin="0,0,0,24">

            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Publiczne zestawy"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>

                <TextBlock Text="Przeglądaj publiczne zestawy innych użytkowników i pobieraj je do siebie."
                           FontSize="15"
                           Foreground="#64748B"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Button Content="Odśwież"
                    Width="120"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="RefreshButton_Click"/>
        </DockPanel>

        <!-- Filtry -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="0,0,0,18"
                Padding="18">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,12,0">

                    <TextBlock Text="Autor"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               Margin="0,0,0,6"/>

                    <Border Background="#F8FAFC"
                            CornerRadius="10"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Height="42"
                            Padding="12,0">

                        <TextBox x:Name="UserNameFilterTextBox"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 FontSize="14"
                                 Foreground="#0F172A"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="0,0,12,0">

                    <TextBlock Text="Kategoria"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               Margin="0,0,0,6"/>

                    <Border Background="#F8FAFC"
                            CornerRadius="10"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Height="42"
                            Padding="12,0">

                        <TextBox x:Name="CategoryFilterTextBox"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 FontSize="14"
                                 Foreground="#0F172A"/>
                    </Border>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Szukaj"
                        Style="{StaticResource PrimaryButtonStyle}"
                        VerticalAlignment="Bottom"
                        Margin="0,0,10,0"
                        Click="SearchButton_Click"/>

                <Button Grid.Column="3"
                        Content="Wyczyść"
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Bottom"
                        Click="ClearFiltersButton_Click"/>
            </Grid>
        </Border>

        <!-- Lista -->
        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Margin="0"
                Padding="0">

            <Grid>
                <TextBlock x:Name="EmptyStateTextBlock"
                           Text="Nie znaleziono publicznych zestawów."
                           FontSize="16"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="22">

                    <ItemsControl x:Name="PublicFlashcardSetsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border Background="#F8FAFC"
                                        CornerRadius="14"
                                        Padding="18"
                                        Margin="0,0,0,14"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Info -->
                                        <StackPanel Grid.Column="0">

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0F172A"/>

                                                <Border Background="#DCFCE7"
                                                        CornerRadius="8"
                                                        Padding="8,3"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center">

                                                    <TextBlock Text="Publiczny"
                                                               Foreground="#15803D"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="13"
                                                       Foreground="#64748B"
                                                       TextWrapping="Wrap"
                                                       Margin="0,8,0,0"/>

                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,12,0,0">

                                                <TextBlock Text="{Binding FlashcardsText}"
                                                           FontSize="13"
                                                           Foreground="#475569"
                                                           Margin="0,0,16,0"/>

                                                <TextBlock Text="{Binding CategoryText}"
                                                           FontSize="13"
                                                           Foreground="#475569"
                                                           Margin="0,0,16,0"/>

                                                <TextBlock Text="{Binding AuthorText}"
                                                           FontSize="13"
                                                           Foreground="#475569"
                                                           Margin="0,0,16,0"/>

                                                <TextBlock Text="{Binding CreatedAtText}"
                                                           FontSize="13"
                                                           Foreground="#475569"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Akcja -->
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="18,0,0,0">

                                            <Button Content="Pobierz"
                                                    Width="110"
                                                    Height="38"
                                                    Tag="{Binding Id}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="CopyButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>