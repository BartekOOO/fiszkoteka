<UserControl x:Class="QuizMaster.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="850">

    <Grid Background="#F8FAFC">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0"
                   Margin="0,0,0,28">

            <StackPanel DockPanel.Dock="Left">

                <TextBlock FontSize="30"
                           FontWeight="Bold"
                           Foreground="#0F172A">
                    <TextBlock.Text>
                        <Binding Path="UserName"
                                 StringFormat="Witaj ponownie, {0}"/>
                    </TextBlock.Text>
                </TextBlock>

                <TextBlock Text="Kontynuuj naukę albo utwórz nowy zestaw fiszek."
                           FontSize="15"
                           Foreground="#64748B"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right">

                <Button Content="+ Nowy zestaw"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="135"
                        Margin="0,0,10,0"
                        Click="CreateFlashcardSet_Click"/>

                <Button Content="Rozpocznij naukę"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="150"/>
            </StackPanel>
        </DockPanel>

        <!-- Statystyki -->
        <Grid Grid.Row="1"
              Margin="0,0,0,8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="📚"
                               FontSize="26"/>

                    <TextBlock Text="{Binding FlashcardSetsCount}"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               Margin="0,12,0,0"/>

                    <TextBlock Text="Zestawów fiszek"
                               Foreground="#64748B"
                               FontSize="14"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="🧠"
                               FontSize="26"/>

                    <TextBlock Text="{Binding FlashcardsCount}"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               Margin="0,12,0,0"/>

                    <TextBlock Text="Fiszek łącznie"
                               Foreground="#64748B"
                               FontSize="14"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="🔥"
                               FontSize="26"/>

                    <TextBlock Text="{Binding LearningStreakDays, StringFormat={}{0} dni}"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               Margin="0,12,0,0"/>

                    <TextBlock Text="Seria nauki"
                               Foreground="#64748B"
                               FontSize="14"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="✅"
                               FontSize="26"/>

                    <TextBlock Text="{Binding EffectivenessPercent, StringFormat={}{0}%}"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               Margin="0,12,0,0"/>

                    <TextBlock Text="Skuteczność"
                               Foreground="#64748B"
                               FontSize="14"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Dolna część -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- Ostatnie zestawy -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,18,0">

                <StackPanel>

                    <DockPanel Margin="0,0,0,18">
                        <TextBlock Text="Ostatnie zestawy"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   DockPanel.Dock="Left"/>

                        <TextBlock Text="Zobacz wszystkie"
                                   Foreground="#2563EB"
                                   FontWeight="SemiBold"
                                   Cursor="Hand"
                                   HorizontalAlignment="Right"
                                   DockPanel.Dock="Right"/>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding RecentSets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border Background="#F8FAFC"
                                        CornerRadius="12"
                                        Padding="16"
                                        Margin="0,0,0,12">

                                    <DockPanel LastChildFill="False">

                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0F172A"/>

                                            <TextBlock FontSize="13"
                                                       Foreground="#64748B"
                                                       Margin="0,4,0,0">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} fiszki • {1}">
                                                        <Binding Path="FlashcardsCount"/>
                                                        <Binding Path="LastLearningText"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>

                                        <Button Content="Ucz się"
                                                Width="90"
                                                Height="34"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                DockPanel.Dock="Right"/>
                                    </DockPanel>
                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

            <!-- Panel boczny -->
            <StackPanel Grid.Column="1">

                <!-- Dzisiejszy cel -->
                <Border Style="{StaticResource CardStyle}"
                        Margin="0,0,0,18">

                    <StackPanel>
                        <TextBlock Text="Dzisiejszy cel"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>

                        <TextBlock Text="Powtórz przynajmniej 30 fiszek, żeby utrzymać serię."
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Foreground="#64748B"
                                   Margin="0,10,0,18"/>

                        <ProgressBar Height="10"
                                     Minimum="0"
                                     Maximum="{Binding DailyGoal.TargetFlashcardsCount}"
                                     Value="{Binding DailyGoal.ReviewedFlashcardsCount}"
                                     Foreground="#2563EB"
                                     Background="#E2E8F0"/>

                        <TextBlock Foreground="#64748B"
                                   FontSize="13"
                                   HorizontalAlignment="Right"
                                   Margin="0,8,0,0">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} / {1} fiszek">
                                    <Binding Path="DailyGoal.ReviewedFlashcardsCount"/>
                                    <Binding Path="DailyGoal.TargetFlashcardsCount"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Aktywne sesje -->
                <Border Style="{StaticResource CardStyle}"
                        Margin="0,0,0,18">

                    <StackPanel>
                        <TextBlock Text="Kontynuuj naukę"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,16"/>

                        <ItemsControl ItemsSource="{Binding ActiveSessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border Background="#F8FAFC"
                                            CornerRadius="12"
                                            Padding="12"
                                            Margin="0,0,0,10">

                                        <StackPanel>
                                            <TextBlock Text="{Binding FlashcardSetName}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0F172A"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock FontSize="12"
                                                       Foreground="#64748B"
                                                       Margin="0,4,0,0">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} / {1} fiszek">
                                                        <Binding Path="ReviewedFlashcardsCount"/>
                                                        <Binding Path="TotalFlashcardsCount"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>

                                            <ProgressBar Height="8"
                                                         Minimum="0"
                                                         Maximum="{Binding TotalFlashcardsCount}"
                                                         Value="{Binding ReviewedFlashcardsCount}"
                                                         Margin="0,8,0,0"
                                                         Foreground="#2563EB"
                                                         Background="#E2E8F0"/>
                                        </StackPanel>
                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>


            </StackPanel>
        </Grid>
    </Grid>
</UserControl>