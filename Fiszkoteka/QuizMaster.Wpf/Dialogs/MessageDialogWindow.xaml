<Window x:Class="QuizMaster.Wpf.Dialogs.MessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Komunikat"
        Height="220"
        Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Background="White"
            BorderBrush="#D6DCE5"
            BorderThickness="1"
            CornerRadius="8">

        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="0"
                              Opacity="0.18"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    x:Name="HeaderBorder"
                    Background="#DC2626"
                    CornerRadius="8,8,0,0"
                    BorderBrush="#C81E1E"
                    BorderThickness="0,0,0,1">

                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="IconTextBlock"
                               Grid.Column="0"
                               Text="✕"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <TextBlock x:Name="TitleTextBlock"
                               Grid.Column="1"
                               Text="Tytuł"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="2"
                            Content="✕"
                            Width="30"
                            Height="30"
                            FontSize="14"
                            Foreground="White"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1"
                  Margin="20,18,20,12">
                <TextBlock x:Name="MessageTextBlock"
                           Text="Treść komunikatu"
                           FontSize="15"
                           Foreground="#334155"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           LineHeight="22"/>
            </Grid>

            <!-- Buttons -->
            <Border Grid.Row="2"
                    Background="#F8FAFC"
                    BorderBrush="#E5EAF0"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8">

                <Grid Margin="20,10">
                    <StackPanel x:Name="OkButtonPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="OK"
                                Width="92"
                                Height="34"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="OkButton_Click"/>
                    </StackPanel>

                    <StackPanel x:Name="QuestionButtonPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Visibility="Collapsed">

                        <Button Content="Nie"
                                Width="92"
                                Height="34"
                                Background="#E5E7EB"
                                Foreground="#1F2937"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Margin="0,0,8,0"
                                Click="NoButton_Click"/>

                        <Button Content="Tak"
                                Width="92"
                                Height="34"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="YesButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>