<Window x:Class="QuizMaster.Wpf.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rejestracja"
        Height="590"
        Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3F4F6">

    <Window.Resources>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="InputPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Border Width="360"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Utwórz konto"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Zarejestruj się, aby korzystać z QuizMastera"
                               FontSize="13"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Username -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="Nazwa użytkownika"
                               Style="{StaticResource LabelStyle}"/>

                    <TextBox x:Name="UsernameTextBox"
                             Style="{StaticResource InputTextBoxStyle}"/>
                </StackPanel>

                <!-- Email -->
                <StackPanel Grid.Row="4">
                    <TextBlock Text="Adres e-mail"
                               Style="{StaticResource LabelStyle}"/>

                    <TextBox x:Name="EmailTextBox"
                             Style="{StaticResource InputTextBoxStyle}"/>
                </StackPanel>

                <!-- Password -->
                <StackPanel Grid.Row="6">
                    <TextBlock Text="Hasło"
                               Style="{StaticResource LabelStyle}"/>

                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource InputPasswordBoxStyle}"/>
                </StackPanel>

                <!-- Repeat Password -->
                <StackPanel Grid.Row="8">
                    <TextBlock Text="Powtórz hasło"
                               Style="{StaticResource LabelStyle}"/>

                    <PasswordBox x:Name="RepeatPasswordBox"
                                 Style="{StaticResource InputPasswordBoxStyle}"/>
                </StackPanel>

                

                <!-- Register button -->
                <Button Grid.Row="12"
                        x:Name="RegisterButton"
                        Content="Zarejestruj"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="RegisterButton_Click"/>

                <!-- Login button -->
                <StackPanel Grid.Row="14"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <TextBlock Text="Masz już konto?"
                               Foreground="#64748B"
                               FontSize="13"
                               VerticalAlignment="Center"/>

                    <Button x:Name="BackToLoginButton"
                            Content="Zaloguj się"
                            Margin="8,0,0,0"
                            Padding="10,0"
                            Height="28"
                            FontSize="13"
                            Foreground="#2563EB"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BackToLoginButton_Click"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>