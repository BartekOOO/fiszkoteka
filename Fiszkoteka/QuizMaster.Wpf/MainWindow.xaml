<Window x:Class="QuizMaster.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuizMaster"
        Height="700"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3F6FA">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#1E293B"
                Padding="24">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="QuizMaster"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <TextBlock Text="Panel nauki"
                               Foreground="#94A3B8"
                               FontSize="14"
                               Margin="0,6,0,34"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Content="🏠  Pulpit"
                            Style="{StaticResource SidebarButtonStyle}"
                            x:Name="DashboardButton"
                            Click="NavigateToDashboard"/>

                    <Button Content="📚  Moje zestawy"
                            Click="NavigateToFlashcardSets"
                            x:Name="FlashcardSetsButton"
                            Style="{StaticResource SidebarButtonStyle}"/>


                    <Button Content="📈  Postępy"
                            Click="NavigateToLearningProgress"
                            x:Name="LearningProgressButton"
                            Style="{StaticResource SidebarButtonStyle}"/>

                    <Button Content="⚙  Ustawienia"
                            Click="NavigateToSettings"
                            x:Name="SettingsButton"
                            Style="{StaticResource SidebarButtonStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Background="#0F172A"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,0,14">

                        <StackPanel>
                            <TextBlock Text="Zalogowano jako"
                                       Foreground="#94A3B8"
                                       FontSize="12"/>

                            <TextBlock x:Name="UserNameTextBlock"
                                       Text="Użytkownik"
                                       Foreground="White"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,4,0,0"/>

                            <TextBlock x:Name="UserEmailTextBlock"
                                       Text="email@example.com"
                                       Foreground="#CBD5E1"
                                       FontSize="12"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Wyloguj"
                            Background="#EF4444"
                            Foreground="White"
                            Height="40"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl x:Name="MainContentControl"
                    Grid.Column="1"
                    Background="#F8FAFC"
                    Margin="20"/>
       
    </Grid>
</Window>